   "source": "## Cached Data Var Initialization",
   "id": "26d38d4f192d9b05"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-25T15:10:59.247637Z",
     "start_time": "2026-03-25T15:10:59.189044Z"
    }
   },
   "cell_type": "code",
   "source": [
    "from collections import defaultdict\n",
    "\n",
    "\n",
    "def fill_defaultdict(template_dd, data_dict):\n",
    "    for k, v in data_dict.items():\n",
    "        if isinstance(v, dict) and isinstance(template_dd.get(k), defaultdict):\n",
    "            fill_defaultdict(template_dd[k], v)\n",
    "        else:\n",
    "            template_dd[k] = v\n",
    "    return template_dd\n",
    "\n",
    "\n",
    "cached_data_file_path = \"./cached_data.pkl\"\n",
    "cached_data = defaultdict(lambda: defaultdict(lambda: defaultdict(lambda: defaultdict(lambda: dict()))))"
   ],
   "id": "d284a7e68d2e214c",
   "outputs": [],
   "execution_count": 13
  },
