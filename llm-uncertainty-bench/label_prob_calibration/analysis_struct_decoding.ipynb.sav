   "cell_type": "markdown",
   "source": "## Calibration Plots for Multiple Dataset, Multiple Models",
   "id": "f953f7c5872f228d"
  },
  {
   "metadata": {
    "lines_to_next_cell": 0,
    "ExecuteTime": {
     "end_time": "2026-03-25T15:50:16.184606Z",
