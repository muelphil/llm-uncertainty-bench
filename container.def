Bootstrap: docker
From: nvidia/cuda:12.8.0-runtime-ubuntu22.04

%post
    apt-get update -y && apt-get install -y \
        build-essential \
        python3-dev \
        python3-setuptools \
        python3-pip \
        python3-smbus \
        libncursesw5-dev \
        libgdbm-dev \
        libc6-dev \
        zlib1g-dev \
        libsqlite3-dev \
        tk-dev \
        libssl-dev \
        libffi-dev \
        libbz2-dev \
        liblzma-dev \
        wget \
        git \
        lzma

    # (Optional) clean up apt cache to reduce size
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Create hf_home
    mkdir -p /hf_home
    touch /usr/bin/nvidia-smi

    # Upgrade pip, setuptools, wheel
    python3 -m pip install --upgrade pip setuptools wheel

    # Install vLLM
    python3 -m pip install vllm

%environment
    export HF_HOME=/hf_home
    export PATH=/usr/local/bin:$PATH

%labels
    Author "mueller3@hzdr.de"
    Version "0.1.0"