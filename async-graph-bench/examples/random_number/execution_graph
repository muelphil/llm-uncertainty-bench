// Execution Graph generated by async-graph-bench
digraph {
	node [shape=plaintext]
	ResponseGenerator [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
            <TR><TD>prompt</TD></TR>
            <TR><TD BGCOLOR="#B0D0D0" WIDTH="20"><B>ResponseGenerator</B><BR/><FONT POINT-SIZE="10">Generates a response for a prompt<BR/>using an LLM</FONT></TD></TR>
            <TR><TD>response</TD></TR>
        </TABLE>
        >]
	DummyDataSource [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
            <TR><TD>-</TD></TR>
            <TR><TD BGCOLOR="#B0D0D0" WIDTH="20"><B>DummyDataSource</B></TD></TR>
            <TR><TD>number_items, prompt, extractor</TD></TR>
        </TABLE>
        >]
	LengthExtractor [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
            <TR><TD>extractor, response</TD></TR>
            <TR><TD BGCOLOR="#B0D0D0" WIDTH="20"><B>LengthExtractor</B><BR/><FONT POINT-SIZE="10">Extracts the number of items from<BR/>the model's response</FONT></TD></TR>
            <TR><TD>length</TD></TR>
        </TABLE>
        >]
	SampleLengthCounter [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0">
            <TR><TD>sampled_length, number_items</TD></TR>
            <TR><TD BGCOLOR="#B0D0D0" WIDTH="20"><B>SampleLengthCounter</B><BR/><FONT POINT-SIZE="10">Counts occurrences of each length<BR/>across sampled runs and computes<BR/>accuracy</FONT></TD></TR>
            <TR><TD>-</TD></TR>
        </TABLE>
        >]
	DummyDataSource -> ResponseGenerator
	LengthExtractor -> SampleLengthCounter
	ResponseGenerator -> LengthExtractor
}
